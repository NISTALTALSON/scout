# Copy to .env for local use only. Never paste credentials in chat or commit them.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
TIMEZONE=Asia/Kolkata
# Optional public source/workflow identity; cloud state refuses to use this repository.
GITHUB_REPOSITORY=
# Required together for --cloud-state. Use a separate private repository and branch.
SCOUT_STATE_REPOSITORY=
SCOUT_STATE_TOKEN=
SCOUT_STATE_BRANCH=scout-state
