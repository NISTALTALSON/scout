# Copy to .env for local use only. Never paste credentials in chat or commit them.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
TIMEZONE=Asia/Kolkata
# Optional only outside Actions. Actions supplies GITHUB_TOKEN automatically.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
SCOUT_STATE_BRANCH=scout-state
